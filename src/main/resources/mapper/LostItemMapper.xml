<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.finalexam.mapper.LostItemMapper">

    <resultMap id="LostItemMap" type="com.example.finalexam.entity.LostItem">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="type" column="type"/>
        <result property="location" column="location"/>
        <result property="contact" column="contact"/>
        <result property="status" column="status"/>
        <result property="ownerName" column="owner_name"/>
        <result property="reward" column="reward"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="search"
            parameterType="com.example.finalexam.dto.LostItemQueryDTO"
            resultMap="LostItemMap">
        SELECT
            id,
            title,
            type,
            location,
            contact,
            status,
            owner_name,
            reward,
            created_at
        FROM lost_item
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{keyword}, '%')
                    OR location LIKE CONCAT('%', #{keyword}, '%')
                    OR owner_name LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="maxReward != null">
                AND reward &lt;= #{maxReward}
            </if>
        </where>
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="findById"
            parameterType="int"
            resultMap="LostItemMap">
        SELECT
            id,
            title,
            type,
            location,
            contact,
            status,
            owner_name,
            reward,
            created_at
        FROM lost_item
        WHERE id = #{id}
    </select>

    <insert id="insert"
            parameterType="com.example.finalexam.entity.LostItem"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO lost_item (
            title,
            type,
            location,
            contact,
            status,
            owner_name,
            reward,
            created_at
        )
        VALUES (
            #{title},
            #{type},
            #{location},
            #{contact},
            #{status},
            #{ownerName},
            #{reward},
            NOW()
        )
    </insert>

    <update id="updateStatus">
        UPDATE lost_item
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM lost_item
        WHERE id = #{id}
    </delete>

    <select id="countByStatus" resultType="int">
        SELECT COUNT(*)
        FROM lost_item
        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>
    </select>

</mapper>
